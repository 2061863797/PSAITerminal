<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PSAITerminal</AssemblyName>
    <RootNamespace>PSAITerminal</RootNamespace>
    <Version>0.6.0</Version>
    <AssemblyVersion>0.6.0.0</AssemblyVersion>
    <Description>适用于 Windows PowerShell 5.1 和 PowerShell 7 的本地 AI 终端模块。</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PowerShellStandard.Library" Version="5.1.1">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="AITerminalOfficialIntegration.cs" />
    <Compile Remove="PowerShell7/**/*.cs" />
    <EmbeddedResource Remove="PowerShell7/**" />
    <None Remove="PowerShell7/**" />
  </ItemGroup>
</Project>
